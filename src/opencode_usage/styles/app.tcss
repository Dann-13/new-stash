/* Estilos del dashboard (tema oscuro tipo "Agent usage") */

Screen {
    background: #0b0e14;
    color: #c9d1d9;
}

#range-bar {
    height: 3;
    padding: 0 1;
    align: left middle;
    background: #11161f;
}

#title {
    width: 1fr;
    color: #58a6ff;
}

#range-bar Button {
    margin: 0 1;
    min-width: 6;
}

#updated {
    width: auto;
    min-width: 24;
    content-align: right middle;
}

#cards {
    height: 5;
    padding: 0 1;
}

StatCard {
    width: 1fr;
    height: 4;
    margin: 0 1;
    border: round #21262d;
    background: #11161f;
    padding: 0 1;
    content-align: left middle;
}

#main {
    height: 1fr;
    padding: 0 1;
}

#left {
    width: 1fr;
    height: 100%;
    margin-right: 1;
}

#right {
    width: 1fr;
    height: 100%;
}

TokensByDay {
    height: 1fr;
    border: round #21262d;
    background: #11161f;
    padding: 0 1;
}

Heatmap {
    height: 12;
    border: round #21262d;
    background: #11161f;
    padding: 0 1;
    margin-top: 1;
}

ModelsTable {
    height: 1fr;
    border: round #21262d;
    background: #11161f;
}

AgentsTable {
    height: 1fr;
    border: round #21262d;
    background: #11161f;
    margin-top: 1;
}
